{
  "name": "wildsdeck-streamdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rollup -c && npm run profiles",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "profiles": "node scripts/generate-profiles.mjs",
    "validate": "streamdeck validate com.wildsdeck.streamdeck.sdPlugin",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.wildsdeck.streamdeck\""
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.9.0",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "rollup": "^4.63.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}

